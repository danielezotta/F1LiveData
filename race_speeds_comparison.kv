<RaceSpeedComparison>

    BoxLayout:
        orientation: "vertical"
        size: root.width, root.height
        padding: 32
        spacing: 16

        Button:
            id: exit_button
            text: "<-  BACK"
            font_size: 12
            size_hint: .25, .5
            on_release: root.exit_back()

        Spinner:
            id: year_select
            text: "Select year"
            values: []
            font_size: 32
            on_text: root.year_clicked(year_select.text)

        Label:
            id: race_label
            text: "Race"
            font_size: 32

        Spinner:
            id: race_select
            text: "Select circuit"
            values: []
            font_size: 32
            on_text: root.circuit_clicked(race_select.text)

        Label:
            id: driver_label
            text: "Driver"
            font_size: 32

        Spinner:
            id: driver1_select
            text: "Select driver 1"
            values: []
            font_size: 32
            markup: True
            on_text: root.driver1_clicked(driver1_select.text)

        Spinner:
            id: driver2_select
            text: "Select driver 2"
            values: []
            font_size: 32
            markup: True
            on_text: root.driver2_clicked(driver2_select.text)

        Button:
            id: button_start
            text: "START"
            font_size: 36
            on_release: root.start_clicked()
